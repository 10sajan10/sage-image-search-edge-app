# Copy outside Git, replace placeholders, and pass with docker --env-file.
QDRANT_URL=http://QDRANT_PRIVATE_HOST:6333
COLLECTION=edge_v3_live
NODE_ID=H01E
CAMERA_ID=rtsp-main

EMBED_MODEL_DIR=/model/jina-clip-v2
HF_HOME=/model/hf-cache
REQUIRE_GPU=true

SEARCH_HOST=0.0.0.0
SEARCH_PORT=8099
SEARCH_API_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
WEIGHT_IMAGE=0.60
WEIGHT_CAPTION=0.25
WEIGHT_BM25=0.15
DEFAULT_TOP_K=25
MAX_TOP_K=200
CANDIDATES_PER_LEG=100
SEARCH_MAX_CONCURRENCY=1
SEARCH_REQUEST_TIMEOUT_SECONDS=60
REQUIRE_ACCESSIBLE_IMAGES=true
LOG_LEVEL=INFO
LOG_FORMAT=json
