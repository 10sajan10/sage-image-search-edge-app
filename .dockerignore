# Keep the build context small and reproducible. The Dockerfile ends with
# `COPY . .`, so anything not excluded here is baked into the image.

# Runtime data. These are bind-mounted at run time, never built in -- and they
# grow without bound, so copying them would inflate every image build.
e2e/
data/
state/
frames/
images/
*.jsonl

# Model weights are mounted at EMBED_MODEL_DIR (default /model/weights/...),
# deliberately not baked in: jina-clip-v2 alone is ~1.7 GB and the image is
# already ~24 GB from the CUDA/torch base.
model/
models/
weights/
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# VCS and editor noise
.git/
.gitignore
.github/
.vscode/
.idea/
*.swp

# Python artifacts -- stale bytecode compiled on a different arch/version is a
# real source of confusing import errors inside the container.
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Docs and notebooks: not needed at runtime.
*.md
*.ipynb
deploy/

# Docker's own files never need to be inside the image.
Dockerfile
.dockerignore
