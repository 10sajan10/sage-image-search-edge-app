RUN_MODE=daemon
CAPTURE_SOURCE=camera
CAMERA=CAMERA_NAME_FROM_WAGGLE_DATA_CONFIG
CAMERA_ID=bottom-camera
NODE_ID=H01E
CAPTURE_INTERVAL_SECONDS=180
QDRANT_URL=http://QDRANT_PRIVATE_HOST:6333
COLLECTION=edge_v3_live
OLLAMA_URL=http://OLLAMA_PRIVATE_HOST:11434
CAPTION_MODEL=gemma4:e2b
EMBED_MODEL_DIR=/model/jina-clip-v2
HF_HOME=/model/hf-cache
REQUIRE_GPU=true
FRAME_DIR=/data/frames
SPOOL_DIR=/data/spool
HEARTBEAT_PATH=/data/spool/heartbeat.json
MAX_CAPTURES=0
EXIT_WHEN_DRAINED=false
MAX_INGEST_ATTEMPTS=20
INGEST_RETRY_BASE_SECONDS=5
INGEST_RETRY_MAX_SECONDS=300
PUBLISH_TO_BEEHIVE=true
LOG_LEVEL=INFO
LOG_FORMAT=json
